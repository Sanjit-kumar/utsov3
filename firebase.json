{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.py"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|css|js|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800, must-revalidate"
          }
        ]
      }
    ]
  }
}