# Begin hotlink protection #
RewriteEngine on
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.utsov.org/$1 [R,L]

RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http://utsov.org/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^http://www.utsov.org/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^http://utsov.ipage.com/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^http://www.utsov.ipage.com/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^https://utsov.org/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^https://www.utsov.org/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^https://utsov.ipage.com/.*$ [NC]
RewriteCond %{HTTP_REFERER} !^https://www.utsov.ipage.com/.*$ [NC]
RewriteRule .(gif|jpg|png|tiff)$ - [F]
# End hotlink protection #


